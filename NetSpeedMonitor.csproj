<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetSpeedMonitor</RootNamespace>
    <AssemblyName>NetSpeedMonitor</AssemblyName>
    
    <!-- Application metadata -->
    <Title>NetSpeed Monitor</Title>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>NetSpeed Monitor Project</Company>
    <Product>NetSpeed Monitor for Windows 11</Product>
    <Description>Lightweight real-time network download and upload speed monitor for Windows 11.</Description>
    <Copyright>Copyright © 2026</Copyright>

    <!-- High DPI and OS compatibility manifest -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Release & Publishing defaults -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    
    <!-- Safe trim settings: disabled by default for WinForms to avoid runtime reflection errors -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
